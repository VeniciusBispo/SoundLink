# ─── MongoDB ────────────────────────────────────────────────────────────────────

MONGODB_USER="seu-usuario-atlas"
MONGODB_PASSWORD="sua-senha-atlas"
MONGODB_HOST="cluster0.xxxxxx.mongodb.net"
MONGODB_DATABASE="soundlink"
MONGODB_APP_NAME="Cluster0"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-me"

# Full URL of the deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── YouTube ────────────────────────────────────────────────────────────────────

# YouTube Data API v3 key (console.developers.google.com)
YOUTUBE_API_KEY="your-youtube-api-key"
