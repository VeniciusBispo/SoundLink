# ─── App ────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/soundlink?schema=public"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-me"

# Full URL of the deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── YouTube ────────────────────────────────────────────────────────────────────

# YouTube Data API v3 key (console.developers.google.com)
YOUTUBE_API_KEY="your-youtube-api-key"
